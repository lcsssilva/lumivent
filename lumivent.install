# Hooks do pacote. Só recarrega as regras; não altera o bootloader nem o GRUB.

_reload_udev() {
  if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=hidraw --subsystem-match=i2c-dev || true
  fi
}

post_install() {
  _reload_udev
  cat <<'EOF'
==> Lumivent instalado.

Para o SMBus das memórias (PIIX4 0x0B00), acrescente
  acpi_enforce_resources=lax
à linha de comando do kernel e reinicie. Em GRUB:
  sudoedit /etc/default/grub
  # GRUB_CMDLINE_LINUX_DEFAULT="... acpi_enforce_resources=lax"
  sudo grub-mkconfig -o /boot/grub/grub.cfg

Depois de entrar de novo na sessão, confira em Configurações → Permissões e
sistema. Detalhes: /usr/share/doc/lumivent/guide/installation.md.
EOF
}

post_upgrade() {
  _reload_udev
}

post_remove() {
  _reload_udev
}
